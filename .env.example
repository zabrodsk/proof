# Only needed on a host without the existing macOS Keychain credential.
# Supply this through your shell or secret manager; Proof does not load .env files.
# TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
PORT=4317
# Set to false to disable macOS Keychain lookup.
PROOF_USE_KEYCHAIN=true
# Hosted deployment only. Store credentials as hosting secrets, never in Git.
PROOF_HOSTED=false
# PROOF_ACCESS_KEY=
