# Railway web and worker configuration template. Replace references in Railway's
# Variables UI; never commit real credentials. Direct npm commands do not load .env.
PROOF_HOSTED=true
PROOF_USE_KEYCHAIN=false
# DATABASE_URL=<private PostgreSQL URL with pgvector available>
# Web only: random secret of at least 24 characters, also used as the class join code.
# PROOF_ACCESS_KEY=
# WorkOS AuthKit replaces the class-password sign-in when configured.
# Set all four on the web service; partial configuration prevents startup.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=https://YOUR_APP_HOST/auth/callback
# WORKOS_COOKIE_PASSWORD=  # Generate with: openssl rand -hex 32
# Web only: keep the existing Railway volume mounted at /app/.data.
PROOF_ACCOUNTS_FILE=/app/.data/accounts.json
# Railway supplies PORT. Direct local development defaults to 4317.
# PORT=4317

# Both processes use the same private Railway S3 bucket.
# Use the bucket Credentials tab or Railway variable references, not a public URL.
# STORAGE_BUCKET=<BUCKET>
# STORAGE_ENDPOINT=<ENDPOINT>
# STORAGE_ACCESS_KEY_ID=<ACCESS_KEY_ID>
# STORAGE_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
STORAGE_REGION=auto
# R2 fallback: leave STORAGE_* credentials unset and supply this complete set.
# R2_BUCKET=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Provider secrets belong on both services. Consent is still required per run/upload.
# TYPESAFE_API_KEY=
# EXA_API_KEY=
# OPENALEX_API_KEY=
# FIRECRAWL_API_KEY=
JEV_MODEL=jev-latest
PROOF_WORKER_CONCURRENCY=2
# Worker only; web leaves this unset.
# PROOF_PROCESS=worker

# The Docker build verifies and bakes this immutable model into /app/models.
# Keep both services on these settings; Railway values override image defaults.
PROOF_EMBEDDINGS=true
PROOF_MODEL_DIR=/app/models
PROOF_EMBEDDING_REVISION=ea104dacec62c0de699686887e3f920caeb4f3e3

# Optional direct local development overrides, with DATABASE_URL set:
# PROOF_HOSTED=false
# PROOF_ACCOUNTS_FILE=.data/accounts.json
# PROOF_STORAGE_DIR=.data/library
# PROOF_MODEL_DIR=.data/models
# PROOF_EMBEDDINGS=false
# For local semantic search, run npm run model:prepare then enable embeddings.
# On macOS, PROOF_USE_KEYCHAIN=true enables existing provider Keychain credentials.
# Start web with npm run dev and the separate worker with npm run worker.
# Optional Compose loads .env; leave cloud bucket credentials unset for local files.
