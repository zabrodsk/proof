# Only needed on a host without the existing macOS Keychain credential.
# Supply this through your shell or secret manager; Proof does not load .env files.
# TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
PORT=4317
# Set to false to disable macOS Keychain lookup.
PROOF_USE_KEYCHAIN=true
# Hosted deployment only. Store credentials as hosting secrets, never in Git.
PROOF_HOSTED=false
# Server-only session-signing secret, at least 24 characters. Never a join code.
# PROOF_ACCESS_KEY=

# WorkOS AuthKit. Setting any WorkOS variable requires all four.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=http://127.0.0.1:4317/auth/callback
# WORKOS_COOKIE_PASSWORD=  # Generate with: openssl rand -hex 32

# Persistent analysis backend (web + worker). Never commit real credentials.
# DATABASE_URL=<private PostgreSQL URL with pgvector available>
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# Local file fallback when cloud storage is unset:
# PROOF_STORAGE_DIR=.data/library
# EXA_API_KEY=
# OPENALEX_API_KEY=
# FIRECRAWL_API_KEY=
# PROOF_WORKER_CONCURRENCY=2
# PROOF_PROCESS=worker
# PROOF_EMBEDDINGS=false
# PROOF_MODEL_DIR=.data/models
# After npm run model:prepare, set PROOF_EMBEDDINGS=true for local semantic search.

# Durable website checks. These are opt-in; existing browser workflows still work.
PROOF_INTEGRATIONS_ENABLED=false
# DATABASE_URL=postgresql://...  (hosting secret; use a private PostgreSQL service)
# The app and separate worker must use the same DATABASE_URL and JEV_MODEL.
# Production canonical site is app-proof.up.railway.app; set an explicit deployment URL.
# PROOF_PUBLIC_URL=https://app-proof.up.railway.app
PROOF_CHECK_CREATION_ENABLED=true
PROOF_USER_DAILY_BUDGET_USD=1
PROOF_PROVIDER_DAILY_BUDGET_USD=20
# Conservative reservation price. Update against the actual provider contract.
PROOF_JEV_USD_PER_MILLION=0.042

# Remote MCP requires an established OAuth authorization server, separately
# configured for authorization-code + S256 PKCE, consent, scopes and callbacks.
# Website WorkOS sign-in alone does not configure WorkOS Connect.
PROOF_MCP_ENABLED=false
# PROOF_MCP_RESOURCE=https://app-proof.up.railway.app/mcp
# PROOF_OAUTH_ISSUER=https://your-authkit-domain.authkit.app
# PROOF_OAUTH_JWKS_URL=https://your-authkit-domain.authkit.app/oauth2/jwks
# PROOF_OAUTH_INTROSPECTION_URL=https://your-authkit-domain.authkit.app/oauth2/introspection
# Optional server-only authorization header for the provider's introspection endpoint.
# PROOF_OAUTH_INTROSPECTION_AUTHORIZATION=...  (hosting secret)
# Explicitly registered platform clients; no automatic acceptance of arbitrary clients.
# PROOF_CHATGPT_CLIENT_ID=...
# PROOF_CLAUDE_CLIENT_ID=...
# Enable only when OAuth sub is the immutable ID of an existing Proof account,
# as in the WorkOS browser sign-in implementation. Imports start with an empty selection.
PROOF_OAUTH_AUTO_GRANT=false
PROOF_EXA_RESERVATION_USD=0.02
PROOF_FIRECRAWL_RESERVATION_USD=0.02
# Shared backend: PostgreSQL must support pgvector, and hosted files use a private bucket.
# STORAGE_BUCKET=...
# STORAGE_ENDPOINT=https://...
# STORAGE_ACCESS_KEY_ID=...  (secret)
# STORAGE_SECRET_ACCESS_KEY=...  (secret)
# WORKOS_API_KEY=...  (secret)
# WORKOS_CLIENT_ID=...
# WORKOS_REDIRECT_URI=https://your-proof-host/auth/callback
# WORKOS_COOKIE_PASSWORD=...  (server-only secret, at least 32 characters)
